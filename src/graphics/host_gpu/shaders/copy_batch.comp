#version 460
// KYTY_COPY_BATCH (CommandBuffer::BatchCopy): a run of independent small buffer copies in one dispatch, one
// workgroup per copy. Each entry: source and destination device addresses, the dword count.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint words[]; };

struct Copy {
    uint64_t source;
    uint64_t destination;
    uint     dwords;
    uint     unused;
};

layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Table { Copy copies[]; };

layout(push_constant) uniform Parameters {
    uint64_t table;
    uint     count;
} parameters;

void main() {
    const uint index = gl_WorkGroupID.x;
    if (index >= parameters.count) return;
    const Copy copy = Table(parameters.table).copies[index];
    Words source = Words(copy.source);
    Words destination = Words(copy.destination);
    for (uint i = gl_LocalInvocationID.x; i < copy.dwords; i += 64u) {
        destination.words[i] = source.words[i];
    }
}
